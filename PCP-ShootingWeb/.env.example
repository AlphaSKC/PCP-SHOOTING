# Plantilla. Copia este archivo como .env.local y llena los valores.
# Después de cambiar algo, reinicia `npm run dev`.

# ─── Supabase (login) ────────────────────────────────────────────
# Panel de Supabase → botón "Connect" (arriba) o Project Settings → API Keys.
# Solo la URL y la clave PÚBLICA (publishable o, en proyectos antiguos, anon).
# Nunca pongas aquí la "secret" ni la "service_role": esas son solo del backend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Datos ───────────────────────────────────────────────────────
# demo → datos de ejemplo del frontend (no requiere la API)
# api  → API C# real (en desarrollo usa el proxy de Vite hacia API_PROXY_TARGET)
VITE_DATA_SOURCE=demo

# URL base de la API. Vacío = mismo origen (/api, con el proxy de Vite en desarrollo).
# En producción (Vercel) apunta al App Service de Azure, p. ej. https://pcp-api.azurewebsites.net
VITE_API_URL=

# Solo desarrollo: a dónde redirige el proxy de Vite las llamadas a /api.
API_PROXY_TARGET=http://localhost:5026
